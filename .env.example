# AInewsroom Environment Configuration
# Copy this to .env and fill in your values

# ── Required ──────────────────────────────
# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────
# ElevenLabs for TTS (Content Studio)
ELEVENLABS_API_KEY=

# Database (override defaults)
# DATABASE_URL=postgresql+asyncpg://ainewsroom:ainewsroom@localhost:5432/ainewsroom

# Redis
# REDIS_URL=redis://localhost:6379/0

# Security
# SECRET_KEY=change-me-to-a-long-random-string

# Debug mode
# DEBUG=false

# ── Optional Feed Sources ──────────────────
# Add default RSS feed URLs (comma-separated)
# DEFAULT_RSS_FEEDS=https://feeds.example.com/rss
