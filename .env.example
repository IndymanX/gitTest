# AInewsroom Environment Configuration
# Copy this to .env and fill in your values

# ── Required ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional — AI Models ──────────────────
# ElevenLabs for TTS voiceover (Content Studio)
ELEVENLABS_API_KEY=

# ── Optional — Security ───────────────────
# Set to enable X-API-Key header auth; leave empty for open access (dev)
API_KEY=
# SECRET_KEY=change-me-to-a-long-random-string

# ── Optional — Token Budget ───────────────
# Monthly token limit shown as % in Settings → Token Usage (0 = no limit)
MONTHLY_TOKEN_BUDGET=0

# ── Optional — Social Publishing ─────────
# LINE Notify — generate free token at notify.line.me
LINE_NOTIFY_TOKEN=

# Facebook Page — from Meta Developer Console
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Twitter / X — requires Elevated API access + OAuth 1.0a
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Database ──────────────────────────────
# DATABASE_URL=postgresql+asyncpg://ainewsroom:ainewsroom@localhost:5432/ainewsroom

# ── Redis ─────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Dev ───────────────────────────────────
# DEBUG=false
